# Direkter Zugriff: http://127.0.0.1:8080
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# Optionales Caddy-Profil: docker compose --profile proxy up -d --build
# Für öffentliches HTTPS eine Domain mit auf diesen Server zeigenden DNS-Einträgen setzen.
CADDY_SITE=http://localhost
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
